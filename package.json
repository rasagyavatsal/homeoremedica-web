{
  "name": "@homeoremedica/web",
  "version": "5.4.0",
  "private": true,
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "with-node-24": "npx --yes --package=node@24 --",
    "dev": "npm run with-node-24 -- next dev",
    "build": "npm run generate-demo-db && npm run with-node-24 -- next build --webpack",
    "start": "npm run with-node-24 -- next start",
    "lint": "npm run with-node-24 -- eslint . && uv run --project rag --locked ruff check --config rag/pyproject.toml rag",
    "generate-demo-db": "npm run with-node-24 -- node scripts/generate-demo-db.js",
    "typecheck": "npm run with-node-24 -- tsc --noEmit && uv run --project rag --locked pyright --project rag",
    "test": "npm run with-node-24 -- vitest run && uv run --project rag --locked pytest rag/tests",
    "test:watch": "npm run with-node-24 -- vitest",
    "test:coverage": "npm run with-node-24 -- vitest run --coverage",
    "deploy-dev": "npm run with-node-24 -- firebase deploy --project development --only apphosting:homeoremedica-web-dev",
    "deploy-prod": "npm run with-node-24 -- firebase deploy --project production --only apphosting:homeoremedica-web",
    "deploy-prod-preview": "npm run with-node-24 -- firebase deploy --project production --only apphosting:homeoremedica-web-preview",
    "validate": "npm run generate-demo-db && npm run lint && npm run typecheck && npm test && npm run build",
    "rag": "uv run --project rag --locked homeoremedica-chat",
    "rag:sync": "npm run rag -- sync",
    "rag:chat": "npm run rag -- chat",
    "rag:serve": "npm run rag -- serve",
    "rag:deploy": "./scripts/deploy-rag.sh"
  },
  "dependencies": {
    "@google-cloud/firestore": "^7.11.3",
    "@google-cloud/storage": "^7.18.0",
    "@honeybadger-io/js": "^6.15.3",
    "@honeybadger-io/nextjs": "^5.10.14",
    "@honeybadger-io/react": "^6.1.29",
    "@openai/codex-security": "^0.1.6",
    "@opentelemetry/api": "^1.9.0",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-label": "^2.1.15",
    "@radix-ui/react-popover": "^1.1.23",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-separator": "^1.1.15",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-switch": "^1.3.7",
    "@radix-ui/react-tabs": "^1.1.21",
    "@radix-ui/react-tooltip": "^1.2.16",
    "@types/node": "^26.1.2",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "autoprefixer": "^10.5.4",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.0.0",
    "firebase": "^12.9.0",
    "firebase-admin": "^13.4.0",
    "firebase-functions": "^7.3.0",
    "framer-motion": "^12.38.0",
    "lucide-react": "^0.292.0",
    "newrelic": "^13.10.0",
    "next": "^16.2.12",
    "nodemailer": "^9.0.3",
    "postcss": "^8.5.23",
    "qs": "^6.15.2",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "sharp": "^0.35.3",
    "sqlite3": "^6.0.1",
    "tailwind-merge": "^3.6.0",
    "typescript": "^5.2.2",
    "zod": "^4.3.6",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/nodemailer": "^7.0.11",
    "@types/sqlite3": "^3.1.11",
    "@vitejs/plugin-react": "^6.0.4",
    "@vitest/coverage-v8": "^4.0.18",
    "dotenv": "^17.2.1",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.2.12",
    "fast-glob": "^3.3.3",
    "firebase-tools": "^15.24.0",
    "jsdom": "^29.1.1",
    "playwright": "^1.62.0",
    "tailwindcss": "^4.1.18",
    "vite": "8.1.5",
    "vitest": "^4.0.18"
  },
  "allowScripts": {
    "protobufjs@7.6.5": true,
    "sharp@0.33.5": true,
    "sqlite3@5.1.7": true,
    "unrs-resolver@1.12.2": true,
    "@firebase/util@1.15.1": true,
    "sharp@0.34.5": true
  }
}
